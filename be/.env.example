APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database (Supabase Postgres / Local Postgres)
# Supabase Direct / Session Pooler (Project ref: qqfyitqxrcufjskwaldp, Region: ap-northeast-2):
# DATABASE_URL=postgresql+psycopg://postgres.qqfyitqxrcufjskwaldp:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://sekilas:sekilas@localhost:5432/sekilas
SUPABASE_URL=https://qqfyitqxrcufjskwaldp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lcbTN_odHD3JCdPqbUFfLw_vkeTdfWq
# Kunci rahasia backend untuk membuat Signed URL Supabase Storage privat (opsional di lokal)
SUPABASE_SECRET_KEY=
# Rahasia HMAC untuk Signed URL media lokal & masa berlaku URL (detik)
MEDIA_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# LLM

# OpenAI API (Simulasi Agen & Persona)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Gemini API (Video Understanding & Transkrip)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cadangan bila model utama kelebihan beban (503/504), dicoba berurutan
GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash"]

# Simulasi
SIM_DEFAULT_AGENTS=500
SIM_DEFAULT_SEED=42
SIM_BATCH_SIZE=10
SIM_CONCURRENCY_LIMIT=5

MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_SIZE_MB=100

# Visual Twin worker
TWIN_QUEUE_NAME=twin
# Mode lokal (PRD 11.2): bangun Visual Twin (COLMAP + Brush) di thread proses API
TWIN_LOCAL_RUNNER=true
TWIN_MAX_FRAMES=300
TWIN_DEVICE=cuda

# Observabilitas
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
