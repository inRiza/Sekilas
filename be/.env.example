APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+psycopg://sekilas:sekilas@localhost:5432/sekilas
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# LLM

# OpenAI API (Simulasi Agen & Persona)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Gemini API (Video Understanding & Transkrip)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Simulasi
SIM_DEFAULT_AGENTS=500
SIM_DEFAULT_SEED=42
SIM_BATCH_SIZE=10
SIM_CONCURRENCY_LIMIT=5

MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_SIZE_MB=100

# Visual Twin worker
TWIN_QUEUE_NAME=twin
TWIN_MAX_FRAMES=300
TWIN_DEVICE=cuda

# Observabilitas
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
