APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+psycopg://sekilas:sekilas@localhost:5432/sekilas
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
VISION_PROVIDER=gemini

# Simulasi
SIM_DEFAULT_AGENTS=500
SIM_DEFAULT_SEED=42

# Visual Twin worker
TWIN_QUEUE_NAME=twin

# Observabilitas
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
